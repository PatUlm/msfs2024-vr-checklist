<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <UseAppHost>true</UseAppHost>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>../../../assets/branding/app-icon-windows.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../config/confirmation-actions.json" LogicalName="VRChecklist.confirmation-actions.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same branding icon as the EXE, exposed to the windows as avares://VRChecklist.Companion/Assets/app-icon.ico -->
    <AvaloniaResource Include="../../../assets/branding/app-icon-windows.ico"
                      Link="Assets/app-icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <ProjectReference Include="../VRChecklist.Transport/VRChecklist.Transport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../release-notes.json"
                      LogicalName="VRChecklist.Companion.release-notes.json" />
    <EmbeddedResource Include="../../../assets/audio/items/*.opus"
                      LogicalName="VRChecklist.Companion.audio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../assets/audio/items/manifest.json"
                      LogicalName="VRChecklist.Companion.audio.items-manifest.json" />
    <EmbeddedResource Include="../../../assets/audio/completion/*.opus"
                      LogicalName="VRChecklist.Companion.audio.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../assets/audio/completion/manifest.json"
                      LogicalName="VRChecklist.Companion.audio.completion-manifest.json" />
    <EmbeddedResource Include="../../../checklists/data/*.json"
                      Exclude="../../../checklists/data/checklist.schema.json"
                      LogicalName="VRChecklist.Companion.checklists.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
