<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <UseAppHost>true</UseAppHost>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.1" />
    <ProjectReference Include="../VRChecklist.Transport/VRChecklist.Transport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../release-notes.json"
                      LogicalName="VRChecklist.Companion.release-notes.json" />
    <EmbeddedResource Include="../../../checklists/data/*.json"
                      Exclude="../../../checklists/data/checklist.schema.json"
                      LogicalName="VRChecklist.Companion.checklists.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
