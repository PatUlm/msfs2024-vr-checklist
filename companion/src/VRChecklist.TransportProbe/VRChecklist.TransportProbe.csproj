<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseAppHost>false</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../VRChecklist.Companion/ChecklistConnectionService.cs"
             Link="ChecklistConnectionService.cs" />
    <Compile Include="../VRChecklist.Companion/ChecklistCatalog.cs"
             Link="ChecklistCatalog.cs" />
    <Compile Include="../VRChecklist.Companion/ChecklistTextFormatter.cs"
             Link="ChecklistTextFormatter.cs" />
    <Compile Include="../VRChecklist.Companion/CompletionSoundPlayer.cs"
             Link="CompletionSoundPlayer.cs" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <ProjectReference Include="../VRChecklist.Transport/VRChecklist.Transport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same checklist resources as the companion so the self-tests exercise the shipped data. -->
    <EmbeddedResource Include="../../../checklists/data/*.json"
                      Exclude="../../../checklists/data/checklist.schema.json"
                      LogicalName="VRChecklist.Companion.checklists.%(Filename)%(Extension)" />
    <!-- Same clip as the companion so the play-completion-sound flag proves the shipped audio path. -->
    <EmbeddedResource Include="../../../assets/audio/checklist-completed.wav"
                      LogicalName="VRChecklist.Companion.audio.checklist-completed.wav" />
  </ItemGroup>
</Project>
