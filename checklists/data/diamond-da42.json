{
  "schemaVersion": 1,
  "id": "diamond-da42",
  "title": "Diamond DA42 – Checklist + ATC",
  "aircraft": {
    "manufacturer": "Diamond",
    "model": "DA42",
    "msfsMatches": [
      { "atcModel": { "equals": "DA42" } },
      { "atcModel": { "equals": "DA42 NG" } },
      { "atcModel": { "equals": "Diamond DA42" } }
    ]
  },
  "revision": "2026-08-23",
  "sections": [
    {
      "id": "before-engine-start",
      "title": "Before Engine Start",
      "items": [
        {
          "id": "power-levers",
          "challenge": "Power Levers [1+2]",
          "response": "Idle",
          "kind": "action",
          "speech": "Power levers, one and two: Idle."
        },
        {
          "id": "parking-brake",
          "challenge": "Parking Brake",
          "response": "Set",
          "kind": "action"
        },
        {
          "id": "flaps",
          "challenge": "Flaps",
          "response": "Up",
          "kind": "action"
        },
        {
          "id": "gear",
          "challenge": "Gear",
          "response": "Down",
          "kind": "action"
        },
        {
          "id": "trim",
          "challenge": "Trim",
          "response": "T/O",
          "kind": "action",
          "speech": "Trim: Takeoff."
        },
        {
          "id": "electric-master",
          "challenge": "Electric Master",
          "response": "On",
          "kind": "action"
        },
        {
          "id": "strobe-lights",
          "challenge": "Strobe Lights",
          "response": "On",
          "kind": "action"
        }
      ]
    },
    {
      "id": "engine-start",
      "title": "Engine Start",
      "items": [
        {
          "id": "fuel-quantity-temperature",
          "challenge": "Fuel Quantity and Temperature",
          "response": "Check",
          "kind": "verify"
        },
        {
          "id": "engine-master-left",
          "challenge": "Engine Master (left)",
          "response": "On",
          "kind": "action"
        },
        {
          "id": "glow-annunciation-left",
          "challenge": "CAP \"L/R GLOW ON\"",
          "response": "Wait",
          "kind": "verify",
          "condition": "Until CAP clears",
          "speech": "Left glow indication: Wait until it clears."
        },
        {
          "id": "start-key-left",
          "challenge": "Start Key",
          "response": "Start and hold",
          "kind": "action",
          "condition": "Until 500 RPM",
          "speech": "Start key: Start and hold until 500 R P M."
        },
        {
          "id": "voltage-electrical-load",
          "challenge": "Voltage and Electrical Load",
          "response": "Check",
          "kind": "verify",
          "speech": "Voltage and electrical load: Check on E I S.",
          "notes": ["On EIS"]
        },
        {
          "id": "engine-master-right",
          "challenge": "Engine Master (right)",
          "response": "On",
          "kind": "action"
        },
        {
          "id": "glow-annunciation-right",
          "challenge": "CAP \"L/R GLOW ON\"",
          "response": "Wait",
          "kind": "verify",
          "condition": "Until CAP clears",
          "speech": "Right glow indication: Wait until it clears."
        },
        {
          "id": "start-key-right",
          "challenge": "Start Key",
          "response": "Start and hold",
          "kind": "action",
          "condition": "Until 500 RPM",
          "speech": "Start key: Start and hold until 500 R P M."
        }
      ]
    },
    {
      "id": "before-taxi",
      "title": "Before Taxi",
      "items": [
        {
          "id": "position-lights",
          "challenge": "Position Lights",
          "response": "On",
          "kind": "action"
        },
        {
          "id": "avionics-master",
          "challenge": "Avionics Master",
          "response": "On",
          "kind": "action"
        },
        {
          "id": "atis",
          "challenge": "ATIS",
          "response": "Get QNH",
          "kind": "communication",
          "speech": "A T I S: Get Q N H."
        },
        {
          "id": "altimeters",
          "challenge": "Altimeters [1+2]",
          "response": "Set QNH",
          "kind": "action",
          "speech": "Altimeters one and two: Set Q N H from A T I S or M E T A R.",
          "notes": ["Use ATIS or METAR"]
        },
        {
          "id": "cage",
          "challenge": "Cage",
          "response": "Pull",
          "kind": "action"
        },
        {
          "id": "ifr-clearance",
          "challenge": "Clearance",
          "response": "Request IFR clearance",
          "kind": "communication",
          "speech": "A T C clearance: Request I F R clearance."
        },
        {
          "id": "transponder",
          "challenge": "Transponder",
          "response": "Set mode and code",
          "kind": "action",
          "speech": "Transponder: Set mode and code. V F R, altitude mode.",
          "notes": ["VFR | ALT"]
        },
        {
          "id": "flight-plan",
          "challenge": "Flight Plan",
          "response": "As required",
          "kind": "action"
        },
        {
          "id": "autopilot",
          "challenge": "Autopilot",
          "response": "As required",
          "kind": "action",
          "speech": "Autopilot: As required. Heading or navigation, altitude, and flight level change.",
          "notes": ["HDG/NAV | ALT | FLC"]
        },
        {
          "id": "gear-fire-warning",
          "challenge": "Gear/Fire Warning",
          "response": "Test",
          "kind": "optional",
          "speech": "Gear and fire warning: Test."
        },
        {
          "id": "engine-warm-up",
          "challenge": "Engine Warm-Up",
          "response": "1,400–1,500 RPM",
          "kind": "optional",
          "speech": "Engine warm-up: Set 1,400 to 1,500 R P M."
        },
        {
          "id": "ecu-test",
          "challenge": "ECU Test [1+2]",
          "response": "Hold for 25 s",
          "kind": "optional",
          "condition": "Until CAP clears",
          "speech": "E C U test one and two: Hold for 25 seconds until the CAP indication clears.",
          "notes": ["Use click spot"]
        }
      ]
    },
    {
      "id": "taxi",
      "title": "Taxi",
      "items": [
        {
          "id": "pushback-request",
          "challenge": "Ground",
          "response": "Request pushback",
          "kind": "communication",
          "speech": "A T C ground: Request pushback."
        },
        {
          "id": "taxi-light",
          "challenge": "Taxi Light",
          "response": "On",
          "kind": "action"
        },
        {
          "id": "parking-brake",
          "challenge": "Parking Brake",
          "response": "Release",
          "kind": "action"
        },
        {
          "id": "pushback",
          "challenge": "Pushback",
          "response": "As required",
          "kind": "action"
        },
        {
          "id": "taxi-clearance",
          "challenge": "Ground",
          "response": "Request taxi to runway",
          "kind": "communication",
          "speech": "A T C ground: Request taxi to the runway."
        },
        {
          "id": "taxi-hold-short",
          "challenge": "Taxi to",
          "response": "Hold Short Line",
          "kind": "action",
          "speech": "Taxi to the hold-short line, maximum 20 knots ground speed.",
          "notes": ["Maximum 20 kt ground speed"]
        }
      ]
    },
    {
      "id": "line-up-and-wait",
      "title": "Line-Up and Wait",
      "items": [
        {
          "id": "departure-request",
          "challenge": "Tower",
          "response": "Request departure",
          "kind": "communication",
          "speech": "A T C tower: Request departure."
        },
        {
          "id": "flaps",
          "challenge": "Flaps",
          "response": "Up",
          "kind": "action",
          "alternatives": [
            {
              "when": "Short Field TO",
              "response": "App (1)"
            }
          ],
          "speech": "Flaps: Up. Alternative short field takeoff: Flaps: Approach one."
        },
        {
          "id": "taxi-lights",
          "challenge": "Taxi Lights",
          "response": "Off",
          "kind": "action"
        },
        {
          "id": "landing-lights",
          "challenge": "Landing Lights",
          "response": "On",
          "kind": "action"
        },
        {
          "id": "fuel-pumps",
          "challenge": "Fuel Pumps [1+2]",
          "response": "On",
          "kind": "action",
          "speech": "Fuel pumps, one and two: On."
        },
        {
          "id": "pitot-heat",
          "challenge": "Pitot Heat",
          "response": "On",
          "kind": "action",
          "condition": "OAT ≤ +5 °C",
          "speech": "Pitot heat: On, when outside air temperature is plus five degrees Celsius or below."
        },
        {
          "id": "taxi-to-runway",
          "challenge": "Taxi to",
          "response": "Runway",
          "kind": "action",
          "speech": "Taxi to the runway."
        },
        {
          "id": "heading",
          "challenge": "HDG",
          "response": "Set",
          "kind": "action",
          "speech": "Heading: Set."
        }
      ]
    },
    {
      "id": "take-off-and-climb",
      "title": "Take-Off & Climb",
      "items": [
        {
          "id": "power-levers-takeoff",
          "challenge": "Power Levers [1+2]",
          "response": "100 %",
          "kind": "action",
          "speech": "Power levers, one and two: 100 percent."
        },
        {
          "id": "rotation-speed",
          "challenge": "Rotation Speed (Vr)",
          "response": "76 kt",
          "kind": "action",
          "alternatives": [
            {
              "when": "Short Field TO",
              "response": "71 kt"
            }
          ],
          "speech": "Rotation speed V R: 76 knots. Alternative short field takeoff: 71 knots."
        },
        {
          "id": "gear",
          "challenge": "Gear",
          "response": "Up",
          "kind": "action",
          "condition": "Positive climb",
          "speech": "Gear: Up, after positive climb."
        },
        {
          "id": "flaps",
          "challenge": "Flaps",
          "response": "Up",
          "kind": "action",
          "condition": "At 92 kt and 200 ft AGL",
          "speech": "Flaps: Up, once reaching 92 knots and 200 feet above ground level."
        },
        {
          "id": "climb-speed",
          "challenge": "Climb Speed (Vy)",
          "response": "92 kt",
          "kind": "action",
          "speech": "Climb speed V Y: 92 knots."
        },
        {
          "id": "fuel-pumps",
          "challenge": "Fuel Pumps [1+2]",
          "response": "Off",
          "kind": "action",
          "condition": "Above 1,000 ft AGL",
          "speech": "Fuel pumps, one and two: Off after passing 1,000 feet above ground level."
        },
        {
          "id": "landing-lights",
          "challenge": "Landing Lights",
          "response": "Off",
          "kind": "action",
          "condition": "Above 10,000 ft",
          "speech": "Landing lights: Off above 10,000 feet."
        },
        {
          "id": "power-levers-climb",
          "challenge": "Power Levers [1+2]",
          "response": "≤ 92 %",
          "kind": "action",
          "speech": "Power levers, one and two: 92 percent or less."
        }
      ]
    },
    {
      "id": "approach",
      "title": "Approach",
      "items": [
        {
          "id": "fuel-pumps",
          "challenge": "Fuel Pumps [1+2]",
          "response": "On",
          "kind": "action",
          "condition": "At TOD",
          "speech": "Fuel pumps, one and two: On at top of descent."
        },
        {
          "id": "landing-lights",
          "challenge": "Landing Lights",
          "response": "On",
          "kind": "action",
          "condition": "Below 10,000 ft",
          "speech": "Landing lights: On below 10,000 feet."
        },
        {
          "id": "approach-speed",
          "challenge": "Approach Speed (Vapp)",
          "response": "85 kt",
          "kind": "action",
          "speech": "Approach speed V app: 85 knots."
        }
      ]
    }
  ]
}
