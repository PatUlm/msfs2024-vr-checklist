{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MSFS 2024 VR Checklist",
  "description": "Versionable structured checklist data for the native EFB app.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "aircraft",
    "revision",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aircraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model"],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revision": {
      "type": "string",
      "format": "date"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "items"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "challenge", "response", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "challenge": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "response": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "kind": {
          "enum": ["action", "verify", "communication"]
        },
        "speech": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "description": "Optional complete English TTS sentence. If omitted, use challenge followed by response."
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "description": "Timing or applicability condition for the canonical response; do not repeat it in response."
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "description": "Context-specific responses that replace the canonical response.",
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "description": "Supplementary display information that is neither a response nor a condition.",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          }
        },
        "needsReview": {
          "type": "boolean"
        },
        "reviewNote": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["needsReview"],
            "properties": {
              "needsReview": {
                "const": true
              }
            }
          },
          "then": {
            "required": ["reviewNote"]
          }
        },
        {
          "if": {
            "required": ["reviewNote"]
          },
          "then": {
            "required": ["needsReview"],
            "properties": {
              "needsReview": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "response"],
      "properties": {
        "when": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "response": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        }
      }
    }
  }
}
