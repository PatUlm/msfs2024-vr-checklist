    "@types/node": "^18.15.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "esbuild": "^0.28.2",
    "esbuild-copy-static-files": "^0.1.0",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.3.0",
    "postcss": "^8.4.30",
    "postcss-prefix-selector": "^1.16.0",
