<Window
    x:Class="VRChecklist.Companion.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VRChecklist.Companion"
    x:DataType="vm:MainWindowViewModel"
    Title="VR Checklist"
    Icon="avares://VRChecklist.Companion/Assets/app-icon.ico"
    Width="720"
    SizeToContent="Height"
    MinWidth="680"
    Background="#10151D"
    FontFamily="Segoe UI">
  <Window.Styles>
    <Style Selector="TextBlock.section-label">
      <Setter Property="Foreground" Value="#8E9AAA" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="#F3F6FA" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#18212C" />
      <Setter Property="BorderBrush" Value="#273646" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <!-- Blue info card, distinct from the neutral status cards. -->
    <Style Selector="Border.card.notice">
      <Setter Property="Background" Value="#12304A" />
      <Setter Property="BorderBrush" Value="#57C8FF" />
    </Style>
    <Style Selector="Border.card.notice TextBlock.section-label">
      <Setter Property="Foreground" Value="#57C8FF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card.notice Button.icon-button">
      <Setter Property="Background" Value="#1A4466" />
      <Setter Property="BorderBrush" Value="#3A7CB0" />
    </Style>
    <Style Selector="Border.card.notice Button.icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#235A85" />
    </Style>
    <Style Selector="Border.card.notice Button.icon-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14364F" />
    </Style>
    <Style Selector="Border.phase-badge">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#57C8FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.phase-badge TextBlock">
      <Setter Property="Foreground" Value="#57C8FF" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="20">
    <!-- The notice sits in the header row so that no empty grid row keeps its spacing. -->
    <StackPanel Grid.Row="0" Spacing="20">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="3">
          <TextBlock Foreground="#F3F6FA" FontSize="28" FontWeight="SemiBold"
                     Text="VR Checklist" />
          <TextBlock Foreground="#8E9AAA" FontSize="14"
                     Text="Companion status" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                    VerticalAlignment="Center">
          <Button Classes="icon-button" Click="OnChecklistsClick"
                  AutomationProperties.Name="Checklists">
            <StackPanel>
              <Path Data="{StaticResource IconChecklist}" />
              <TextBlock Text="Checklists" />
            </StackPanel>
          </Button>
          <Button Classes="icon-button" Click="OnReleaseNotesClick"
                  AutomationProperties.Name="Release Notes">
            <StackPanel>
              <Path Data="{StaticResource IconReleaseNotes}" />
              <TextBlock Text="Release Notes" />
            </StackPanel>
          </Button>
          <Button Classes="icon-button" Click="OnSettingsClick"
                  AutomationProperties.Name="Settings">
            <StackPanel>
              <Path Data="{StaticResource IconSettings}" />
              <TextBlock Text="Settings" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Border Classes="card notice" IsVisible="{Binding Updates.IsNoticeVisible}">
        <StackPanel Spacing="10">
          <TextBlock Classes="section-label" Text="{Binding Updates.NoticeTitle}" />
          <TextBlock Foreground="#F3F6FA" FontSize="15" TextWrapping="Wrap"
                     Text="{Binding Updates.NoticeText}" />
          <TextBlock Foreground="#AAB4C0" TextWrapping="Wrap"
                     Text="{Binding Updates.NoticeDetail}"
                     IsVisible="{Binding Updates.HasNoticeDetail}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="icon-button" Click="OnAllowUpdateChecksClick"
                    IsVisible="{Binding Updates.IsConsentNotice}"
                    AutomationProperties.Name="Allow">
              <StackPanel>
                <!-- Uniform stretch pins the wide check to the top of a square box; its own height centers it. -->
                <Path Data="{StaticResource IconCheck}" Height="12" />
                <TextBlock Text="Allow" />
              </StackPanel>
            </Button>
            <Button Classes="icon-button" Click="OnDeclineUpdateChecksClick"
                    IsVisible="{Binding Updates.IsConsentNotice}"
                    AutomationProperties.Name="Don't check">
              <StackPanel>
                <Path Data="{StaticResource IconClose}" />
                <TextBlock Text="Don't check" />
              </StackPanel>
            </Button>
            <Button Classes="icon-button" Click="OnInstallUpdateClick"
                    IsVisible="{Binding Updates.IsAvailableNotice}"
                    IsEnabled="{Binding Updates.CanInstall}"
                    AutomationProperties.Name="Install update">
              <StackPanel>
                <Path Data="{StaticResource IconDownload}" />
                <TextBlock Text="Install update" />
              </StackPanel>
            </Button>
            <Button Classes="icon-button" Click="OnReleasePageClick"
                    IsVisible="{Binding Updates.HasReleasePage}"
                    AutomationProperties.Name="Release page">
              <StackPanel>
                <Path Data="{StaticResource IconExternal}" />
                <TextBlock Text="Release page" />
              </StackPanel>
            </Button>
            <Button Classes="icon-button" Click="OnPostponeUpdateClick"
                    IsVisible="{Binding Updates.IsAvailableNotice}"
                    IsEnabled="{Binding Updates.CanInstall}"
                    AutomationProperties.Name="Later">
              <StackPanel>
                <Path Data="{StaticResource IconClose}" />
                <TextBlock Text="Later" />
              </StackPanel>
            </Button>
            <Button Classes="icon-button" Click="OnDismissUpdatedClick"
                    IsVisible="{Binding Updates.IsUpdatedNotice}"
                    AutomationProperties.Name="Dismiss">
              <StackPanel>
                <Path Data="{StaticResource IconClose}" />
                <TextBlock Text="Dismiss" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14">
      <Border Grid.Column="0" Classes="card">
        <StackPanel Spacing="7">
          <TextBlock Classes="section-label" Text="SIMULATOR" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                     Fill="{Binding SimulatorStatusColor}" />
            <TextBlock Classes="value" FontWeight="SemiBold"
                       Text="{Binding SimulatorStatus}" />
          </StackPanel>
          <TextBlock Foreground="#AAB4C0" TextWrapping="Wrap"
                     Text="{Binding SimulatorDetail}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="7">
          <TextBlock Classes="section-label" Text="CHECKLIST" />
          <TextBlock Classes="value" FontWeight="SemiBold"
                     Text="{Binding ChecklistStatus}" />
          <TextBlock Foreground="#AAB4C0" TextWrapping="Wrap"
                     Text="{Binding ChecklistDetail}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="card" VerticalAlignment="Top">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="15">
        <Grid Grid.Row="0" ColumnDefinitions="150,*">
          <TextBlock Classes="section-label" VerticalAlignment="Center"
                     Text="AIRCRAFT" />
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Classes="value" Text="{Binding Aircraft}" />
            <Button Classes="icon-button" Click="OnCopyAircraftIdentityClick"
                    IsVisible="{Binding CanCopyAircraftIdentity}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Copy aircraft model identifiers"
                    ToolTip.Tip="Copy ATC MODEL, ATC TYPE and TITLE.">
              <StackPanel>
                <Path Data="{StaticResource IconCopy}" />
                <TextBlock x:Name="CopyAircraftIdentityLabel" Text="Copy" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="150,*">
          <TextBlock Classes="section-label" VerticalAlignment="Center"
                     Text="CHECKLIST" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
            <Path Classes="completion-check" Data="{StaticResource IconCheck}"
                  IsVisible="{Binding IsChecklistCompleted}" />
            <TextBlock Classes="value" Text="{Binding Checklist}" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="150,*">
          <TextBlock Classes="section-label" VerticalAlignment="Center"
                     Text="ACTIVE GROUP" />
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto">
            <Path Classes="completion-check" Data="{StaticResource IconCheck}"
                  Margin="0,0,5,0" IsVisible="{Binding IsActiveGroupCompleted}" />
            <TextBlock Grid.Column="1" Classes="value" Text="{Binding ActiveGroup}"
                       VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="phase-badge" Margin="12,0,0,0"
                    IsVisible="{Binding HasActiveGroupPhase}">
              <TextBlock Text="{Binding ActiveGroupPhase}" />
            </Border>
          </Grid>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="150,*">
          <TextBlock Classes="section-label" VerticalAlignment="Center"
                     Text="NEXT ITEM" />
          <TextBlock Grid.Column="1" Classes="value" Text="{Binding NextItem}" />
        </Grid>
        <Grid Grid.Row="4" ColumnDefinitions="150,*" RowDefinitions="Auto,Auto"
              RowSpacing="8">
          <TextBlock Classes="section-label" VerticalAlignment="Center"
                     Text="PROGRESS" />
          <TextBlock Grid.Column="1" Classes="value" Text="{Binding Progress}" />
          <ProgressBar Grid.Row="1" Grid.Column="1" Height="8"
                       Minimum="0" Maximum="100"
                       Value="{Binding ProgressPercent}" />
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
      <TextBlock Foreground="#718095" FontSize="12"
                 Text="{Binding EfbVersion, StringFormat='EFB {0}'}" />
      <TextBlock Grid.Column="1" Foreground="#718095" FontSize="12"
                 Text="{Binding CompanionVersion, StringFormat='Companion {0}'}" />
    </Grid>
  </Grid>
</Window>
