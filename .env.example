# Copy this file to .env and adjust the Windows-specific paths for your system.
VR_CHECKLIST_MSFS_SDK_ROOT="/mnt/c/MSFS 2024 SDK"
VR_CHECKLIST_COMPANION_STAGING_DIR="/mnt/c/dev/msfs2024-vr-checklist-companion-staging"
VR_CHECKLIST_COMPANION_INSTALL_DIR="/mnt/c/Users/YOUR_WINDOWS_USER/AppData/Local/Programs/VRChecklist Companion"
VR_CHECKLIST_COMMUNITY_DIR="/mnt/c/Users/YOUR_WINDOWS_USER/AppData/Roaming/Microsoft Flight Simulator 2024/Packages/Community2024"
VR_CHECKLIST_RELEASE_DIR="/mnt/c/dev/msfs2024-vr-checklist-releases"

# Optional: developer-only ElevenLabs access for offline speech pre-rendering.
# API key permissions: Text to Speech: Access; Voices: Read.
# Set the real key only in the ignored .env; never include it in shipped apps.
# Free-tier output is for auditions; render release audio anew on a paid plan.
ELEVENLABS_API_KEY=""
# Optional path to a developer-installed FFmpeg with libopus; defaults to ffmpeg.
VR_CHECKLIST_FFMPEG="ffmpeg"
